#!/usr/bin/env bash
# Mint a Keycloak access token for a development-realm user or service account.
#
# Usage:
#   tools/scripts/get_keycloak_token [username|client-id|service-account-client-id] [read|write|none]
#
# The script reads the generated realm import so that credentials remain defined
# in the development configuration instead of being duplicated here.

set -euo pipefail

readonly repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
readonly realm_file="${KEYCLOAK_REALM_FILE:-${repository_root}/tools/generated/keycloak.gateway.realm.json}"
readonly token_config_file="${repository_root}/tools/generated/keycloak.token.config.json"

subject="${1:-}"
scope="${2:-}"

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat >&2 <<'EOF'
Usage: make token <username|client-id|service-account-client-id>
   or: make token KEYCLOAK_SUBJECT=<username|client-id|service-account-client-id>

Optionally provide a high-level scope:
  make token <username|client-id|service-account-client-id> <read|write|none>
  make token KEYCLOAK_SUBJECT=<subject> KEYCLOAK_SCOPE=<read|write|none>
EOF
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

get_user_password() {
    jq --exit-status --raw-output --arg username "$subject" '
        .users[]
        | select(.username == $username)
        | .credentials[]?
        | select(.type == "password")
        | .value
    ' "$realm_file" | head -n 1
}

get_client_secret() {
    local requested_client_id="$1"

    jq --exit-status --raw-output --arg client_id "$requested_client_id" '
        .clients[]
        | select(.clientId == $client_id)
        | .secret
    ' "$realm_file"
}

list_subjects() {
    local client_token_subjects

    printf 'Available Keycloak users:\n'
    jq --raw-output '.users[]?.username' "$realm_file" | sed 's/^/  /'
    printf '\nAvailable Keycloak client token subjects:\n'
    client_token_subjects="$(jq --raw-output '
        .clients[]?
        | select(.protocol == "openid-connect")
        | select(.secret != null and .secret != "**********")
        | .clientId
    ' "$realm_file")"
    if [ -z "$client_token_subjects" ]; then
        printf '  (none found in the generated realm)\n'
        return
    fi

    while IFS= read -r client_id; do
        printf '  %s (or service-account-%s)\n' "$client_id" "$client_id"
    done <<<"$client_token_subjects"
}

list_scopes() {
    printf 'Available Keycloak token scopes:\n'
    printf '  read\n'
    printf '  write\n'
    printf '  none (request neither read nor write)\n'
}

prompt_for_subject() {
    list_subjects >&2
    printf '\nKeycloak user or client token subject: ' >&2
    read -r subject || fail "unable to read a Keycloak token subject"
    [ -n "$subject" ] || fail "a Keycloak token subject is required"
}

prompt_for_scope() {
    list_scopes >&2
    printf '\nKeycloak token scope: ' >&2
    read -r scope || fail "unable to read a Keycloak token scope"
    [ -n "$scope" ] || fail "a Keycloak token scope is required"
}

require_command curl
require_command jq

[ -f "$realm_file" ] || fail "generated Keycloak realm not found: $realm_file. Start the Keycloak development environment first."
[ -f "$token_config_file" ] || fail "generated Keycloak token configuration not found: $token_config_file. Run make token to generate it."

token_endpoint="$(jq --exit-status --raw-output '.token_endpoint' "$token_config_file")" || fail "unable to read token endpoint from $token_config_file"
keycloak_host_header="$(jq --exit-status --raw-output '.host_header' "$token_config_file")" || fail "unable to read Keycloak host header from $token_config_file"

if [ -z "$subject" ]; then
    prompt_for_subject
fi

if [ -z "$scope" ]; then
    prompt_for_scope
fi

case "$scope" in
    read|write) ;;
    none) ;;
    *) fail "unsupported Keycloak token scope '${scope}'; choose read, write, or none" ;;
esac

# `none` intentionally omits the development read/write client scopes. Keycloak
# may still include its standard OIDC scopes, which are unrelated to Gateway's
# API read/write authorization.
requested_scopes="openid profile email"
if [ "$scope" != "none" ]; then
    requested_scopes+=" ${scope}"
fi

if [[ "$subject" == service-account-* ]]; then
    client_id="${subject#service-account-}"
else
    client_id="$subject"
fi

if client_secret="$(get_client_secret "$client_id" 2>/dev/null)"; then
    response="$(curl --silent --show-error --fail --insecure --request POST "$token_endpoint" \
        --header "Host: ${keycloak_host_header}" \
        --data-urlencode 'grant_type=client_credentials' \
        --data-urlencode "client_id=${client_id}" \
        --data-urlencode "client_secret=${client_secret}" \
        --data-urlencode "scope=${requested_scopes}")"
else
    password="$(get_user_password 2>/dev/null)" || fail "no Keycloak user or client named '${subject}' was found in $realm_file"
    response="$(curl --silent --show-error --fail --insecure --request POST "$token_endpoint" \
        --header "Host: ${keycloak_host_header}" \
        --data-urlencode 'grant_type=password' \
        --data-urlencode 'client_id=gateway_oidc_client' \
        --data-urlencode "client_secret=$(get_client_secret gateway_oidc_client)" \
        --data-urlencode "username=${subject}" \
        --data-urlencode "password=${password}" \
        --data-urlencode "scope=${requested_scopes}")"
fi

access_token="$(jq --exit-status --raw-output '.access_token' <<<"$response")"
printf 'export BEARER_TOKEN=%s\n' "$access_token"
