#!/bin/bash
set -o errexit

GATEWAY_BASE_DIR=/opt/aap_gateway
GATEWAY_APP_DIR="${GATEWAY_BASE_DIR}/aap_gateway"
GATEWAY_PYTHON="${GATEWAY_BASE_DIR}/venv/bin/python"
GATEWAY_MANAGE="/usr/bin/gateway-manage"

database_ready() {
${GATEWAY_PYTHON} <<EOF
import sys
from django.db import connection

try:
    connection.ensure_connection()
except Exception:
    sys.exit(1)
EOF
}

until database_ready
do
    echo "Waiting until the database is ready..."
    sleep 5
done

${GATEWAY_MANAGE} migrate --noinput
${GATEWAY_MANAGE} collectstatic --noinput
${GATEWAY_MANAGE} register_service --config /opt/aap_gateway/aap_gateway/tools/generated/proxy.yml
${GATEWAY_MANAGE} authenticators --initialize

cd ${GATEWAY_APP_DIR}
exec supervisord -n
