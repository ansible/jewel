ARG PYTHON=python3.12

FROM quay.io/centos/centos:stream9
ARG PYTHON

LABEL org.opencontainers.image.source="https://github.com/ansible/jewel"
LABEL org.opencontainers.image.description="CI image for jewel (aap-gateway) with pre-built Python dependencies"

ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV PYTHONUNBUFFERED=1
ENV JEWEL_CI_CONTAINER=true

RUN sed -i '/^\[crb\]$/,/^enabled=0$/ s/enabled=0/enabled=1/' /etc/yum.repos.d/centos.repo && \
    dnf install -y \
    diffutils \
    git \
    gcc \
    make \
    nodejs \
    "${PYTHON}-devel" \
    "${PYTHON}" \
    "${PYTHON}-pip" \
    libpq \
    libpq-devel \
    libtool-ltdl-devel \
    openldap-devel \
    openssl-devel \
    xmlsec1-devel \
    xmlsec1-openssl \
    && dnf clean all \
    && mkdir -p /opt/ci-venv \
    && "/usr/bin/${PYTHON}" -m venv /opt/ci-venv

ENV VIRTUAL_ENV=/opt/ci-venv
ENV PATH=/opt/ci-venv/bin:$PATH

COPY requirements/requirements.txt /tmp/requirements.txt
COPY requirements/requirements_ci.txt /tmp/requirements_ci.txt
COPY requirements/requirements_test_ci.txt /tmp/requirements_test_ci.txt

# Install production and CI dependencies from pinned, hashed requirement files.
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: -r /tmp/requirements.txt && \
    pip install --no-cache-dir --require-hashes --only-binary=:all: -r /tmp/requirements_ci.txt

# Pre-seed the tox py312 virtualenv so CI skips the expensive env creation.
# Workflows rely on TOX_WORK_DIR so tox uses this cache instead of ./.tox.
ENV TOX_WORK_DIR=/opt/tox-cache
RUN mkdir -p "${TOX_WORK_DIR}/py312" && \
    python -m venv "${TOX_WORK_DIR}/py312" && \
    "${TOX_WORK_DIR}/py312/bin/pip" install \
        --no-cache-dir --require-hashes --only-binary=:all: \
        -r /tmp/requirements.txt && \
    "${TOX_WORK_DIR}/py312/bin/pip" install \
        --no-cache-dir --require-hashes --only-binary=:all: \
        -r /tmp/requirements_test_ci.txt && \
    rm -f /tmp/requirements*.txt && \
    mkdir -p /home/ci && \
    chown -R 1001:0 /home/ci "${TOX_WORK_DIR}"
ENV HOME=/home/ci
USER 1001:0

WORKDIR /workspace
